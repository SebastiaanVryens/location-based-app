    "@expo/ngrok": "^4.1.3",
    "@expo/ui": "~58.0.23",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "^58.0.0",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-native": "^0.72.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:check": "expo lint",
    "lint:fix": "expo lint --fix",
    "types:check": "tsc --noEmit",
    "types:db": "npx supabase gen types typescript --linked > src/types/database.ts && prettier --write src/types/database.ts",
    "format:check": "prettier --check src",
    "format:fix": "prettier --write src",
    "check": "npm run lint:check && npm run types:check && npm run format:check",
    "fix": "npm run lint:fix && npm run format:fix"
  },
  "private": true
}
